{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./web/src/*"
      ]
    }
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.tsx",
    "src/domains/buaa-classhopper/access-policy/schema.ts",
    "vite.config.ts",
    "vitest.web.config.ts"
  ]
}
