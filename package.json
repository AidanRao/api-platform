{
  "name": "public-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "preview": "vite build --mode preview && vite preview --mode preview",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "typecheck:worker": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:worker && npm run typecheck:web",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test": "npm run test:worker && npm run test:web",
    "deploy:dry": "npm run deploy:production:dry",
    "deploy": "npm run deploy:production",
    "deploy:production:dry": "npm run build:production && wrangler deploy --config web/dist/api_platform/wrangler.json --dry-run",
    "deploy:production": "npm run build:production && wrangler deploy --config web/dist/api_platform/wrangler.json",
    "seed:local": "wrangler kv key put --binding=API_PLATFORM_KV buaa-classhopper:iclass:access-policy:v1 --path=./seed/access-policy.json",
    "seed:remote": "npm run seed:production",
    "seed:production": "wrangler kv key put --binding=API_PLATFORM_KV buaa-classhopper:iclass:access-policy:v1 --path=./seed/access-policy.json --remote --env production",
    "db:migrate:local": "wrangler d1 migrations apply API_PLATFORM_DB --local",
    "db:migrate:production": "wrangler d1 migrations apply API_PLATFORM_DB --remote --env production"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@cloudflare/vitest-plugin": "1.1.6",
    "@cloudflare/workers-types": "5.20260908.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.130.0"
  }
}
