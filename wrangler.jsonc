{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "api-platform",
	"main": "src/entry.ts",
	"compatibility_date": "2026-09-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": true,
	"workflows": [{ "name": "iclass-checkin", "binding": "ICLASS_CHECKIN_WORKFLOW", "class_name": "IclassCheckinWorkflow" }],
	"triggers": { "crons": ["* * * * *"] },
	"vars": {
		"TEAM_DOMAIN": "https://YOUR_TEAM.cloudflareaccess.com",
		"ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
		"ENVIRONMENT": "development",
		"ACCESS_BYPASS_LOCAL": "false",
		"SSO_ISSUER": "https://sso-test.aidanrao.top",
		"ICLASS_SERVICE_BASE_URL": "http://127.0.0.1:8020",
		"OSS_BUCKET": "",
		"OSS_REGION": "",
		"OSS_PREFIX": "api-platform"
	},
	"kv_namespaces": [
		{
			"binding": "API_PLATFORM_KV"
		}
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "none",
		"html_handling": "auto-trailing-slash",
		"run_worker_first": [
			"/api/*",
			"/admin/*"
		]
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"d1_databases": [
		{
			"binding": "API_PLATFORM_DB",
			"database_name": "api-platform",
			"migrations_dir": "migrations"
		}
	],
	"env": {
		"production": {
			"name": "api-platform",
			"workflows": [{ "name": "iclass-checkin", "binding": "ICLASS_CHECKIN_WORKFLOW", "class_name": "IclassCheckinWorkflow" }],
			"triggers": { "crons": ["* * * * *"] },
			"workers_dev": false,
			"preview_urls": false,
			"vars": {
				"TEAM_DOMAIN": "https://aidanrao.cloudflareaccess.com",
				"ACCESS_AUD": "2516483d362ddb370dae6ff3d397aa67a300729e6cb130423d73e20f76a7961a",
				"ENVIRONMENT": "production",
				"ACCESS_BYPASS_LOCAL": "false",
				"SSO_ISSUER": "https://sso.aidanrao.top",
				"ICLASS_SERVICE_BASE_URL": "http://localhost",
				"OSS_BUCKET": "aidan-space",
				"OSS_REGION": "cn-beijing",
				"OSS_PREFIX": "api-platform"
			},
			"kv_namespaces": [
				{
					"binding": "API_PLATFORM_KV",
					"id": "ae082c6018fd43b0bb6c62dfe84219d7"
				}
			],
			"vpc_services": [
				{
					"binding": "ICLASS_PRIVATE_API",
					"service_id": "01a11a50-2df6-77f1-b72f-b780c0b15646"
				}
			],
			"routes": [
				{
					"pattern": "api-platform.aidanrao.top",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "API_PLATFORM_DB",
					"database_name": "api-platform-production",
					"database_id": "0516a63f-f454-4a81-a6f5-1d4ceb8caec5",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}
